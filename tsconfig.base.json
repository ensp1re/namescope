{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@nametagged/schemas": ["./packages/schemas/src/index.ts"],
      "@nametagged/core": ["./packages/core/src/index.ts"],
      "@nametagged/adapters": ["./packages/adapters/src/index.ts"],
      "@nametagged/mcp": ["./packages/mcp/src/index.ts"]
    }
  }
}
