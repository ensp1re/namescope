{
  "name": "@nametagged/adapters",
  "version": "0.1.0",
  "description": "Free public-data and local-environment adapters for Nametagged",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/*.js", "dist/*.js.map", "dist/*.d.ts", "dist/*.d.ts.map", "LICENSE"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@nametagged/core": "0.1.0",
    "@nametagged/schemas": "0.1.0",
    "validate-npm-package-name": "^6.0.2"
  }
}
